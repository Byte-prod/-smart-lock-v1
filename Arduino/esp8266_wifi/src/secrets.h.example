/* secrets.h.example — 配置模板（这个文件会上传 GitHub，不含真实密码）
 * 使用方法：
 *   1. 把本文件复制一份，改名为 secrets.h（和本文件同目录）
 *   2. 把下面各项填成你自己的真实值（密码用真实值，不是星号）
 *   3. secrets.h 不会被 git 提交，密码只有你自己知道
 */
#ifndef SECRETS_H
#define SECRETS_H

#define WIFI_SSID       "你的WiFi名称"
#define WIFI_PASSWORD   "******"      // 改成你的WiFi密码
#define MQTT_BROKER     "你的MQTT服务器地址"
#define MQTT_PORT       8883
#define MQTT_USER       "你的MQTT用户名"
#define MQTT_PASS       "******"      // 改成你的MQTT密码
#define DEVICE_ID       "你的设备ID"
#define TOPIC_UP        "/lock/" DEVICE_ID "/up"
#define TOPIC_DOWN      "/lock/" DEVICE_ID "/down"

#endif
